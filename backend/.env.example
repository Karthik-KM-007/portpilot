# =============================================================================
# PortPilot AI — Environment Configuration
# =============================================================================

# Database Connection:
# For local SQLite development (default zero-config fallback):
DATABASE_URL=sqlite:///./portpilot.db

# For Enterprise PostgreSQL:
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
# Example:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/portpilot

# PostgreSQL Connection Pool Tuning:
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# JWT Authentication Security (MUST change in production):
JWT_SECRET=supersecretkey_please_change_in_production_portpilot_ai_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
